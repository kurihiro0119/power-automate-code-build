{
  "uniqueName": "DueSoon",
  "displayName": "期限が近いタスクの通知",
  "description": "平日の朝、SharePoint の未完了タスクのうち期限が近いものを Teams にまとめて投稿する",
  "version": "1.0.0.0",
  "publisher": {
    "uniqueName": "labpublisher",
    "displayName": "Lab Publisher",
    "prefix": "lab",
    "optionValuePrefix": 10000
  },
  "params": {
    "SP_SITE_URL": {
      "description": "SharePoint サイトの URL",
      "example": "https://contoso.sharepoint.com/sites/demo"
    },
    "SP_LIST": {
      "description": "タスクリストの名前 (またはリスト ID)。列の内部名は Title / DueDate (日付) / Status",
      "example": "Tasks"
    },
    "TEAMS_GROUP_ID": {
      "description": "チームの ID (チャネルのリンクに含まれる groupId)",
      "example": "00000000-0000-0000-0000-000000000000"
    },
    "TEAMS_CHANNEL_ID": {
      "description": "チャネルの ID (19:...@thread.tacv2)",
      "example": "19:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@thread.tacv2"
    },
    "WITHIN_DAYS": {
      "description": "今日を含めて何日先までを「近い」とするか。期限を過ぎた未完了も常に含む",
      "default": 3
    }
  }
}
